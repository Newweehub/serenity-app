# ── Azure Cosmos DB ───────────────────────────────────────────────────────────
# Cosmos DB > Keys > URI
AZURE_COSMOS_ENDPOINT=https://serenity-db.documents.azure.com:443/

# Cosmos DB > Keys > Primary Key
AZURE_COSMOS_KEY=your-cosmos-primary-key-here

COSMOS_DATABASE_NAME=serenity

# ── Azure AI Search ───────────────────────────────────────────────────────────
# AI Search > Overview > URL
AZURE_SEARCH_ENDPOINT=https://serenity-search.search.windows.net

# AI Search > Keys > Admin Key 1
AZURE_SEARCH_KEY=your-search-admin-key-here

AZURE_SEARCH_INDEX=journal-entries

# ── Azure AI Foundry ──────────────────────────────────────────────────────────
# Foundry > Overview > Azure OpenAI Endpoint
AZURE_FOUNDRY_ENDPOINT=https://serenity-agents-resource.openai.azure.com

# Foundry > Keys and Endpoint > Key 1
AZURE_FOUNDRY_API_KEY=your-foundry-api-key-here

# Exactly as shown in your Foundry deployment
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
