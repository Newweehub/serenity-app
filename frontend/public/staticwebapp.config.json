{
  "routes": [
    {
      "route": "/api/*",
      "rewrite": "https://serenity-backend-c4cxeedyfahpfpac.southeastasia-01.azurewebsites.net/api/*"
    },
    {
      "route": "/.auth/login/aad",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/.auth/logout",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*","*.{css,js,png,jpg,svg,ico}"]
  }
}